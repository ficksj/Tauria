# ==========================================
# Telegram Bot Configuration
# ==========================================
BOT_TOKEN=your_bot_token_here

# Super Administrators (comma-separated Telegram IDs)
SUPER_ADMIN_IDS=12345678,87654321

# Audit & Alert Log Chat ID (Telegram channel or group ID)
LOG_CHAT_ID=-1001234567890

# ==========================================
# Active Directory (AD DS) Configuration
# ==========================================
AD_SERVER=192.168.201.15
AD_DOMAIN=kdb.kz
AD_USER=svc_kolins@kdb.kz
AD_PASSWORD=your_ad_password_here
AD_SEARCH_BASE=DC=kdb,DC=kz
AD_USE_SSL=False

# Special AD Containers
AD_DISABLED_USERS_OU=OU=Disabled_Users,DC=kdb,DC=kz

# ==========================================
# Network & Infrastructure
# ==========================================
# Path to Kolins Support Bot directory (for logs & audit sharing)
KOLINS_PATH=../Kolins
